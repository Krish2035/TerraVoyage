# Production Environment Configuration for Render & Neon Tech
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# Neon Tech PostgreSQL Connection String (replace with your Neon URI)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection Pool limits
PGMAX=10
